[Unit]
Description=Svoi private messenger
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/svoi-chat
Environment=SVOI_DATA_DIR=/opt/svoi-chat/data
EnvironmentFile=-/etc/svoi-chat.env
ExecStart=/opt/svoi-chat/venv/bin/uvicorn server:app --host 127.0.0.1 --port 8010
Restart=always
RestartSec=3
User=root

[Install]
WantedBy=multi-user.target
