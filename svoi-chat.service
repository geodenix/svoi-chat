[Unit]
Description=Svoi private messenger
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/svoi-chat
Environment=SVOI_DATA_DIR=/opt/svoi-chat/data
EnvironmentFile=-/etc/svoi-chat.env
ExecStart=/opt/svoi-chat/venv/bin/uvicorn server:app --host 127.0.0.1 --port 8010
Restart=always
RestartSec=3
User=daemon
Group=daemon
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
RestrictSUIDSGID=true
Environment=PYTHONDONTWRITEBYTECODE=1
ProtectSystem=strict
ReadWritePaths=/opt/svoi-chat/data
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
LockPersonality=true
RestrictRealtime=true
RestrictNamespaces=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
